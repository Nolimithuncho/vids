# The AI that watches your videos: gemini (free tier) or claude (paid API)
VID_PROVIDER=gemini

# Free Gemini key: https://aistudio.google.com/apikey
GEMINI_API_KEY=paste-your-gemini-key-here

# Only needed if VID_PROVIDER=claude (https://platform.claude.com/settings/keys)
# ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning (defaults shown)
# VID_GEMINI_MODEL=gemini-flash-latest
# VID_CLAUDE_MODEL=claude-opus-5-5
# VID_SEGMENT_SECONDS=300            # length of each chunk the AI watches
# VID_FRAMES_PER_SEGMENT=30          # frames sampled per chunk
# VID_PARALLEL_SEGMENTS=2            # chunks analyzed at the same time (2 for Gemini free tier)
# VID_WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
# VID_WHISPER_DEVICE=auto            # auto | cpu | cuda
# VID_DATA_DIR=./data
