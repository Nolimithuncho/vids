# Required: your Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Optional tuning (defaults shown)
# VID_MODEL=claude-opus-5-5          # or claude-sonnet-5-5 to cut cost roughly in half
# VID_EFFORT=medium                  # low | medium | high | xhigh | max
# VID_SEGMENT_SECONDS=300            # length of each chunk Claude watches
# VID_FRAMES_PER_SEGMENT=30          # frames sampled per chunk
# VID_PARALLEL_SEGMENTS=4            # chunks analyzed at the same time
# VID_WHISPER_MODEL=small            # tiny | base | small | medium | large-v3
# VID_WHISPER_DEVICE=auto            # auto | cpu | cuda
# VID_USE_FALLBACKS=1                # retry declined requests on a fallback model
# VID_DATA_DIR=./data
